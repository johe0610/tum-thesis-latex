\contentsline {figure}{\numberline {8.2}{\ignorespaces Resolution plots for the ML-based \ensuremath {\ensuremath {W}\xspace _\mathrm {had}}\xspace particle level reconstruction. The kinematic observables transverse momentum \ensuremath {p_{\text {T}}}\xspace (\ref {fig:WhadrecoML:reso_pt_part}), pseudo-rapidity $\ensuremath {\storeEta }\xspace $ (\ref {fig:WhadrecoML:reso_eta_part}) and azimuthal angle $\varphi $ (\ref {fig:WhadrecoML:reso_phi_part}) of the particle level \ensuremath {\ensuremath {W}\xspace _\mathrm {had}}\xspace candidate are being compared to \ensuremath {\ensuremath {W}\xspace _\mathrm {truth}}\xspace .}}{51}{figure.caption.26}%
\contentsline {figure}{\numberline {8.3}{\ignorespaces Resolution plots for the ML-based \ensuremath {\ensuremath {W}\xspace _\mathrm {had}}\xspace reconstruction on detector level. The kinematic observables transverse momentum \ensuremath {p_{\text {T}}}\xspace (\ref {fig:WhadrecoML:reso_pt_reco}), pseudo-rapidity $\ensuremath {\storeEta }\xspace $ (\ref {fig:WhadrecoML:reso_pt_reco}) and azimuthal angle $\varphi $ (\ref {fig:WhadrecoML:reso_phi_reco}) of the \ensuremath {\ensuremath {W}\xspace _\mathrm {had}}\xspace candidate are being compared to \ensuremath {\ensuremath {W}\xspace _\mathrm {truth}}\xspace .}}{52}{figure.caption.27}%
