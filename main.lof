\contentsline {figure}{\numberline {6.1}{\ignorespaces Comparison of the particle and detector level reconstruction of the hadronically decaying \ensuremath {W}\xspace from light jets.}}{39}{figure.caption.19}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Comparison of the particle and detector level reconstruction of the hadronically decaying \ensuremath {W}\xspace from light jets. Only events passing $60<m(\ensuremath {\ensuremath {W}\xspace _\mathrm {cand}}\xspace )<100$ GeV are considered for the calculation of the purity.}}{39}{figure.caption.20}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Comparison of the particle (left) and detector level (right) reconstruction of the hadronically decaying \ensuremath {W}\xspace from light jets. Different combinations of jets are pre-selected as the \ensuremath {W}\xspace candidate. The candidate that minimizes \(|m(\ensuremath {W}\xspace )-m(\ensuremath {\ensuremath {W}\xspace _\mathrm {cand}}\xspace )|\) is selected as pseudo-\ensuremath {W}\xspace . Only events passing the $60<m(\ensuremath {\ensuremath {W}\xspace _\mathrm {cand}}\xspace )<100$ GeV cut are considered in the lower row. The results are compared to the purities obtained from a DNN. More information is given in the text.}}{40}{figure.caption.21}%
