\contentsline {figure}{\numberline {3.1}{\ignorespaces Overview of CERN accelerator complex showing pre-accelerators and the LCH (dark blue) with the four major experiments ATLAS, CMS, ALICE and LHCb~\blx@tocontentsinit {0}\cite {Mobs:2636343}.}}{6}{figure.caption.3}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Plots summarizing luminosity and data quality reported by the LHC and ATLAS during Run 2 from 2015 to 2018. \ref {fig:ATLAS:PileUp}~Distribution of the mean number of interactions per bunch crossing, $\mu $, weighted by the luminosity. The individual distributions for each year of $pp$ collision data taking during Run 2 are shown. The mean $\mu $ value for each year are given in the legend. \ref {fig:ATLAS:IntLumi}~Cumulative integrated luminosity delivered to and recorded by the ATLAS experiment during Run 2. Data recorded at $\sqrt {s}=13~\text {TeV}\xspace $ during stable beam $pp$ collisions is considered, including special runs for detector calibration. The data sample certified for physics analysis usage is shown in light blue with the \textit {Good for Physics} label. Figures taken from Ref.~\blx@tocontentsinit {0}\cite {DAPR-2018-01}.}}{8}{figure.caption.4}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Schematic diagram of the ATLAS detector~\blx@tocontentsinit {0}\cite {CERN-GE-0803012}.}}{9}{figure.caption.5}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Illustration of the ATLAS coordinate system. Figure taken from Ref.~\blx@tocontentsinit {0}\cite {ATLAS-OUTREACH-2025-016}.}}{10}{figure.caption.6}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Geometry of the ATLAS magnet system. The eight coils of the barrel toroid and the two end-cap toroids are highlighted in blue. The solenoid winding which is located in the calorimeter volume is not shown~\blx@tocontentsinit {0}\cite {ATLAS-OUTREACH-2021-075}.}}{11}{figure.caption.7}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Labeled drawing of the ATLAS Inner Detector~\blx@tocontentsinit {0}\cite {CERN-GE-0803014}.}}{12}{figure.caption.8}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Schematic drawing of the ATLAS calorimetry system~\blx@tocontentsinit {0}\cite {CERN-GE-0803015}.}}{14}{figure.caption.9}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Configuration of the muon spectrometer with its four chamber sub-systems~\blx@tocontentsinit {0}\cite {CERN-GE-0803017}.}}{16}{figure.caption.10}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Cross-section of the muon system in a plane containing the beam axis. Infinite-momentum muons would propagate along straight trajectories with fixed $\ensuremath {\storeEta }\xspace $. Figure taken from~\blx@tocontentsinit {0}\cite {TRIG-2012-03}.}}{17}{figure.caption.11}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces The ATLAS TDAQ system as it was used in Run 2. Components relevant for triggering as well as the detector read-out and data flow are shown. Figure taken from~\blx@tocontentsinit {0}\cite {TRIG-2019-04}.}}{19}{figure.caption.12}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Schematic diagram of the ATLAS detector illustrating the signal that various particles induce in the detector. Dashed lines indicate no measurable signal~\blx@tocontentsinit {0}\cite {ATLAS-OUTREACH-2021-052}.}}{20}{figure.caption.13}%
