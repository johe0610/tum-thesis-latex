\@writefile{lof}{\contentsline {figure}{\numberline {5.13}{\ignorespaces Efficiencies of the optimized reconstruction of a hadronically decaying \PW  boson from light jets. The highest efficiencies can be obtained when a cut on the mass of the reconstructed \PW  is applied. Only events with \(\qty {60} < m(\ensuremath  {\PW  _\mathrm  {had}}\xspace  ) < \qty {100}{\ensuremath  {\text  {GeV}}\xspace  }\) are considered in \subref {fig:WhadReco_5cands_mass} and \subref {fig:WhadReco_3cands_mass}, while no mass cut is applied in \subref {fig:WhadReco_5cands} and \subref {fig:WhadReco_3cands}. Panel~\subref {fig:WhadReco_3cands_mass} shows the efficiency of the method that is used in the analysis. It considers the leading jet, the sub-leading jet, as well as their sum as candidates for the hadronic \PW  . More information is given in the caption of \cref  {fig:WhadReco_naive} and in the text.}}{61}{figure.caption.73}\protected@file@percent }
\newlabel{fig:WhadReco_best}{{5.13}{61}{Efficiencies of the optimized reconstruction of a hadronically decaying \Wboson boson from light jets. The highest efficiencies can be obtained when a cut on the mass of the reconstructed \Wboson is applied. Only events with \(\qty {60} < m(\Whad ) < \qty {100}{\GeV }\) are considered in \protect \subref {fig:WhadReco_5cands_mass} and \protect \subref {fig:WhadReco_3cands_mass}, while no mass cut is applied in \protect \subref {fig:WhadReco_5cands} and \protect \subref {fig:WhadReco_3cands}. Panel~\protect \subref {fig:WhadReco_3cands_mass} shows the efficiency of the method that is used in the analysis. It considers the leading jet, the sub-leading jet, as well as their sum as candidates for the hadronic \Wboson . More information is given in the caption of \cref {fig:WhadReco_naive} and in the text}{figure.caption.73}{}}
