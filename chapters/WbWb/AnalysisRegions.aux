\@writefile{lof}{\contentsline {figure}{\numberline {5.11}{\ignorespaces Simple reconstruction of a \PW  boson from light jets. Select the 1, 2, or 3-jet combination closest to the \PW  mass or with the highest \ensuremath  {p_{\text  {T}}}\xspace  . This can be done on detector (reconstruction) and on particle level. The three curves show the reconstruction efficiency between the reconstruction, particle and parton level. The efficiency is defined as number of matched events divided by the total number of events passing the baseline cuts. An event is considered matched between two levels when the respective \PW  candidates fulfil \( \Delta R < 0.5 \). \subref {fig:WhadReco_1jm} Reconstruct from the jet with mass closest to the \PW  mass, \subref {fig:WhadReco_2jm} Reconstruct from the two jet combination with mass closest to the \PW  mass, \subref {fig:WhadReco_3jm} Reconstruct from the three jet combination with mass closest to the \PW  mass, \subref {fig:WhadReco_1jpt} Reconstruct from the jet with highest \ensuremath  {p_{\text  {T}}}\xspace  , \subref {fig:WhadReco_2jpt} Reconstruct from the two jet combination with highest \ensuremath  {p_{\text  {T}}}\xspace  , \subref {fig:WhadReco_3jpt} Reconstruct from the three jet combination with highest \ensuremath  {p_{\text  {T}}}\xspace  . }}{58}{figure.caption.71}\protected@file@percent }
\newlabel{fig:WhadReco_naive}{{5.11}{58}{Simple reconstruction of a \Wboson boson from light jets. Select the 1, 2, or 3-jet combination closest to the \Wboson mass or with the highest \pt . This can be done on detector (reconstruction) and on particle level. The three curves show the reconstruction efficiency between the reconstruction, particle and parton level. The efficiency is defined as number of matched events divided by the total number of events passing the baseline cuts. An event is considered matched between two levels when the respective \Wboson candidates fulfil \( \Delta R < 0.5 \). \protect \subref {fig:WhadReco_1jm} Reconstruct from the jet with mass closest to the \Wboson mass, \protect \subref {fig:WhadReco_2jm} Reconstruct from the two jet combination with mass closest to the \Wboson mass, \protect \subref {fig:WhadReco_3jm} Reconstruct from the three jet combination with mass closest to the \Wboson mass, \protect \subref {fig:WhadReco_1jpt} Reconstruct from the jet with highest \pt , \protect \subref {fig:WhadReco_2jpt} Reconstruct from the two jet combination with highest \pt , \protect \subref {fig:WhadReco_3jpt} Reconstruct from the three jet combination with highest \pt }{figure.caption.71}{}}
